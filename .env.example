# ===================================================================
# CarbonIQ Environment Variables Configuration
# ===================================================================

# -------------------------------------------------------------------
# 1. AI Engine: Groq API Key (Only AI Provider Used)
# -------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
# Powers real-time Llama 3.3 70B inference for optimization insights,
# steel plant load shifting advice, and ESG compliance audit summaries.
GROQ_API_KEY=gsk_your_groq_api_key_here

# -------------------------------------------------------------------
# 2. Database & Auth: Supabase Configuration
# -------------------------------------------------------------------
# Supabase project URL and keys (from Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# Service role key required for src/seed_emission_factors.py
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# -------------------------------------------------------------------
# 3. Kaggle Dataset Integration
# -------------------------------------------------------------------
# Dataset: csafrit2/steel-industry-energy-consumption
# From Kaggle -> Account -> Create New API Token (kaggle.json)
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-api-key"

# -------------------------------------------------------------------
# 4. Server & Hosting Configuration
# -------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"
